#include <windows.h>
#define SEIZA_OPTIONS_DIALOG 17000
#define SEIZA_OPTIONS_TEXT 17001
#define SEIZA_FLOAT_CHOICE 17002
#define SEIZA_INTEGER_CHOICE 17003

SEIZA_OPTIONS_DIALOG DIALOGEX 0, 0, 340, 205
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Seiza Astronomy Formats"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", SEIZA_OPTIONS_TEXT, 12, 12, 316, 125
    AUTORADIOBUTTON "32-bit floating point", SEIZA_FLOAT_CHOICE, 12, 143, 305, 12, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "16-bit integer", SEIZA_INTEGER_CHOICE, 12, 161, 305, 12
    DEFPUSHBUTTON "OK", IDOK, 214, 183, 54, 14
    PUSHBUTTON "Cancel", IDCANCEL, 274, 183, 54, 14
END
